# Public canonical URL used for metadata and stable links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional durable Postgres storage. The reader falls back to the reviewed
# fixture inventory when this is absent.
DATABASE_URL=
EDITORIAL_STORAGE=fixture

# Protects the Vercel cron endpoint. Vercel sends this as a Bearer token.
CRON_SECRET=

# Live intake/generation is opt-in. The Preview remains fully usable without it.
ENABLE_LIVE_INGESTION=false

# Optional editorial model provider.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
